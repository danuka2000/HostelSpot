{
  "expo": {
    "name": "HostelSpot",
    "slug": "hostelspot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#122C23"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#122C23"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.hostelspot.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "HostelSpot needs access to your photos to upload room photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c00fe84a-c64b-4808-a519-717bc3f0900a"
      }
    }
  }
}
